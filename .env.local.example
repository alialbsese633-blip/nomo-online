# Copy this file to .env.local for local development and fill in the
# values from Supabase (Project Settings -> Data API). These same two
# values must also be added as Environment Variables in the Vercel
# project settings for the live site to work.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# WhatsApp lead notifications via CallMeBot (free, personal use).
# WHATSAPP_NOTIFY_PHONE is the number that receives new-lead alerts,
# in international format with no "+" or spaces (e.g. 96877260789).
# Get WHATSAPP_NOTIFY_APIKEY by messaging the CallMeBot number on
# WhatsApp — see https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_NOTIFY_PHONE=96877260789
WHATSAPP_NOTIFY_APIKEY=your-callmebot-apikey
