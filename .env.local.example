# Copy this file to .env.local for local development and fill in the
# values from Supabase (Project Settings -> Data API). These same two
# values must also be added as Environment Variables in the Vercel
# project settings for the live site to work.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
